{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic Code Review Config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "rules": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "severities": {
      "type": "object",
      "additionalProperties": { "enum": ["low", "medium", "high"] }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "appType": {
      "enum": ["", "monolith", "microservice", "public-api", "frontend", "library"]
    },
    "ignorePaths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "customQuestions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "customDomainQuestions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "domainCatalogs": {
      "type": "array",
      "items": { "enum": ["lgpd", "privacy", "finance", "financial", "health", "ecommerce", "education", "social", "iot"] }
    },
    "dastTargets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "performanceTargets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "a11yTargets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "graphqlBaseSchema": {
      "type": "string"
    },
    "graphqlHeadSchema": {
      "type": "string"
    },
    "bundleStatsPath": {
      "type": "string"
    },
    "coverageLinesMin": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "reviewFeedbackPath": {
      "type": "string"
    },
    "externalToolTimeoutMs": {
      "type": "number",
      "minimum": 1000
    }
  }
}
