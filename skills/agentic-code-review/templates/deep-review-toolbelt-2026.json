{
  "referenceDate": "2026-04-29",
  "policy": {
    "requiredByDefault": false,
    "downloadExecution": "opt-in only with --allow-tool-downloads",
    "reviewUse": "additive evidence; verify findings against code before reporting",
    "timeout": "controlled by --external-tool-timeout-ms"
  },
  "tools": [
